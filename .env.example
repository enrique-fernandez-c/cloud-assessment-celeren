# Correo de contacto de Celeren usado en el CTA "Agenda una reunión" y en el envío de resumen.
VITE_CELEREN_CONTACT_EMAIL=contacto@celeren.com

# (Opcional) Endpoint backend propio que redacte el FODA/recomendaciones con IA
# (Anthropic/OpenAI) a partir de los puntajes ya calculados. Si no se configura,
# la app usa automáticamente el fallback basado en reglas (ver src/logic/scoring.js).
# IMPORTANTE: nunca pongas la API key de Anthropic/OpenAI en variables VITE_* —
# quedarían expuestas en el bundle del navegador. Este endpoint debe vivir en tu
# propio backend/función serverless, que guarde la key del lado del servidor.
# VITE_AI_ENDPOINT=https://tu-backend.example.com/api/ai-swot
